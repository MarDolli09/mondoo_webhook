# Vorlage fuer eine lokale .env. In Azure kommen die Werte aus den App Settings
# bzw. aus Key-Vault-Referenzen. Pflichtwerte ohne Default sind markiert.

# Pflicht
MONDOO_API_KEY=
# Authentifizierung der Mondoo-Zustellungen (Werte aus dem Key Vault)
MONDOO_WEBHOOK_SIGNING_SECRET=whsec_<von Mondoo generiert>
MONDOO_WEBHOOK_AUTH_HEADER_VALUE=Bearer <zufaelliges Token>
SNOW_PASSWORD=
SNOW_INSTANCE_URL=https://<instanz>.service-now.com
SNOW_AUTH_MODE=oauth
SNOW_USER=
# 32-stellige sys_id des Katalogformulars auf der angesprochenen Instanz
SNOW_CATALOG_ITEM_SYS_ID=

# Pflicht bei SNOW_AUTH_MODE=oauth
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=

# Optional (Defaults in app/core/config.py)
# Nur setzen, um im Namen eines anderen Benutzers zu bestellen; das ist in
# ServiceNow rollenpflichtig. Leer: der angemeldete Benutzer bestellt selbst.
SNOW_REQUESTED_FOR_SYS_ID=
# SNOW_USER_LOOKUP_FIELDS=["user_name","email","name"]
# HTTP_TIMEOUT_SECONDS=10.0
# MONDOO_MAX_FINDING_LOOKUPS=5
# MONDOO_WEBHOOK_AUTH_HEADER=Authorization
# MONDOO_WEBHOOK_TOLERANCE_SECONDS=300
# DEBUG, INFO, WARNING oder ERROR; DEBUG zeigt Details wie den normalisierten Case
# LOG_LEVEL=INFO

# Stammdaten lassen sich als JSON ueberschreiben (Defaults in app/core/master_data.py):
# CATEGORY_MAP, USER_MAP, PRIORITY_MAP, FINDING_TYPE_MAP,
# DEFAULT_CVE, DEFAULT_URGENCY_IMPACT
