<mxfile host="app.diagrams.net"><diagram id="ticket-states" name="Zustandsdiagramm eines Tickets: Mondoo-Ereignisse und RITM-Status"><mxGraphModel dx="1441" dy="619" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1441" pageHeight="619" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ticket-states_n_events" value="&lt;b&gt;Ereignisse aus Mondoo&lt;/b&gt;&lt;br&gt;erstellt = TYPE_CREATED, aktualisiert = TYPE_UPDATED,&lt;br&gt;geschlossen = TYPE_CLOSED (oder Status CASE_CLOSED),&lt;br&gt;gelöscht = TYPE_DELETED" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=9;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20.0" y="20.0" width="369.0" height="74.0" as="geometry"/></mxCell><mxCell id="ticket-states_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30.0" y="300.0" width="20.0" height="20.0" as="geometry"/></mxCell><mxCell id="ticket-states_none" value='&lt;b&gt;Kein RITM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Case ohne Ticket&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=1;arcSize=17;" vertex="1" parent="1"><mxGeometry x="110.0" y="275.0" width="190.0" height="70.0" as="geometry"/></mxCell><mxCell id="ticket-states_open" value='&lt;b&gt;Offen&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;RITM-Status 1&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=1;arcSize=17;" vertex="1" parent="1"><mxGeometry x="570.0" y="275.0" width="200.0" height="70.0" as="geometry"/></mxCell><mxCell id="ticket-states_closed" value="&lt;b&gt;Abgeschlossen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=12;fontColor=#000000;align=center;verticalAlign=top;spacing=8;strokeWidth=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="980.0" y="150.0" width="300.0" height="340.0" as="geometry"/></mxCell><mxCell id="ticket-states_s3" value='&lt;b&gt;Geschlossen – abgeschlossen&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Status 3&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=1;arcSize=18;" vertex="1" parent="1"><mxGeometry x="1010.0" y="195.0" width="240.0" height="56.0" as="geometry"/></mxCell><mxCell id="ticket-states_s4" value='&lt;b&gt;Geschlossen – unvollständig&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Status 4&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=1;arcSize=18;" vertex="1" parent="1"><mxGeometry x="1010.0" y="285.0" width="240.0" height="56.0" as="geometry"/></mxCell><mxCell id="ticket-states_s7" value='&lt;b&gt;Geschlossen – übersprungen&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Status 7&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=1;arcSize=18;" vertex="1" parent="1"><mxGeometry x="1010.0" y="375.0" width="240.0" height="56.0" as="geometry"/></mxCell><mxCell id="ticket-states_n_map" value="&lt;b&gt;Zuordnung über correlation_id = Case-MRN.&lt;/b&gt;&lt;br&gt;Hinweis bei „geschlossen“: behoben oder Ausnahme, Zeit buchen,&lt;br&gt;SCTASK schließen; bei „gelöscht“: fachlich prüfen." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=9;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20.0" y="540.0" width="392.0" height="59.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=12;fontColor=#000000;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ticket-states_start" target="ticket-states_none"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;erstellt, aktualisiert&lt;/b&gt;&lt;br&gt;/ Request bestellen, RITM ergänzen,&lt;br&gt;SCTASK-Titel setzen" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=12;fontColor=#000000;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ticket-states_none" target="ticket-states_open"><mxGeometry x="0.000" relative="1" as="geometry"><mxPoint x="0.0" y="-31.0" as="offset"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;geschlossen, gelöscht&lt;/b&gt;&lt;br&gt;/ kein Ticket" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=12;fontColor=#000000;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3421;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6579;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ticket-states_none" target="ticket-states_none"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="175.0" y="215.0"/><mxPoint x="235.0" y="215.0"/></Array><mxPoint x="0.0" y="-22.0" as="offset"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;aktualisiert&lt;/b&gt;&lt;br&gt;/ Arbeitsnotiz; Urgency und Impact&lt;br&gt;(außer bei Quelle Default)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=12;fontColor=#000000;endArrow=open;endSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ticket-states_open" target="ticket-states_open"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="630.0" y="215.0"/><mxPoint x="710.0" y="215.0"/></Array><mxPoint x="0.0" y="-30.0" as="offset"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;Prüf-SCTASK&lt;/b&gt;&lt;br&gt;&lt;b&gt;geschlossen&lt;/b&gt;&lt;br&gt;/ Workflow: Status 3" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=12;fontColor=#000000;endArrow=open;endSize=10;labelBackgroundColor=none;exitX=1.0000;exitY=0.2857;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ticket-states_open" target="ticket-states_s3"><mxGeometry x="-0.045" relative="1" as="geometry"><Array as="points"><mxPoint x="870.0" y="295.0"/><mxPoint x="870.0" y="223.0"/></Array><mxPoint x="-61.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;geschlossen, gelöscht&lt;/b&gt;&lt;br&gt;/ Hinweis an RITM und&lt;br&gt;offene SCTASKs, Status bleibt" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=12;fontColor=#000000;endArrow=open;endSize=10;labelBackgroundColor=none;exitX=0.1000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ticket-states_open" target="ticket-states_open"><mxGeometry x="-0.333" relative="1" as="geometry"><Array as="points"><mxPoint x="590.0" y="405.0"/><mxPoint x="650.0" y="405.0"/></Array><mxPoint x="-90.0" y="27.0" as="offset"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;manuell in ServiceNow geschlossen&lt;/b&gt;" style=