<mxfile host="app.diagrams.net"><diagram id="security" name="Sicherheitsarchitektur: Vertrauensgrenzen und Schutzmaßnahmen"><mxGraphModel dx="1410" dy="709" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="709" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="security_z_internet" value='&lt;span style="color:#C0392B"&gt;&lt;b&gt;Internet · Mondoo Cloud&lt;/b&gt;&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C0392B;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20.0" y="20.0" width="330.0" height="520.0" as="geometry"/></mxCell><mxCell id="security_z_azure" value='&lt;span style="color:#C0392B"&gt;&lt;b&gt;Azure · Ressourcengruppe&lt;/b&gt;&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C0392B;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450.0" y="20.0" width="520.0" height="520.0" as="geometry"/></mxCell><mxCell id="security_z_snow" value='&lt;span style="color:#C0392B"&gt;&lt;b&gt;ServiceNow-Instanz&lt;/b&gt;&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C0392B;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070.0" y="20.0" width="320.0" height="520.0" as="geometry"/></mxCell><mxCell id="security_webhook" value='&lt;b&gt;Webhook-Integration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;je Space, signiert&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A3A3FF;strokeColor=#2B2B8F;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;strokeWidth=1;arcSize=11;" vertex="1" parent="1"